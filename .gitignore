# --- Go ---
# Build output
/bin/
# Stray `go build` binaries at repo root (named after cmd/ dirs)
/cask
/cask-apiserver
/cask-bench
# Test binaries / profiles produced by `go test`
*.test
*.out
*.prof
coverage.txt
coverage.html
# Go workspace files (machine-local)
go.work
go.work.sum
# Vendored deps (this project uses modules, not vendoring)
/vendor/

# --- Devbox ---
# Generated environment state (includes the local GOPATH from devbox.json)
.devbox/

# --- Generated cluster configs & certs ---
# `cask gen-certs` writes node configs, CA, and keys here by default
/clusterconf/
*.pem
*.crt
*.key

# --- Multi-cloud demo runtime state (demo/) ---
# Generated ssh keypair, per-cloud .env (public IPs / resource ids), laptop pid+log
/demo/state/
# Filled-in cloud credentials + key material — NEVER commit these
/demo/credentials.yaml
/demo/secrets/

# --- TLA+ / TLC (tla/) ---
# TLC model-checker output and toolbox state
*.toolbox/
states/
*.tlaps/
*.dot
MC.cfg
MC.tla
*.old

# --- Editor / OS ---
.DS_Store
*.swp
*~
.idea/
.vscode/

# --- Claude Code ---
.claude/
