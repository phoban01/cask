{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": [
    "go@latest",
    "quint@latest",
    "jdk@21",
    "kind@latest",
    "kubectl@latest",
    "cargo@latest",
    "rustc@latest",
    "google-cloud-sdk@latest",
    "awscli2@latest",
    "oci-cli@latest",
    "yq-go@latest"
  ],
  "env": {
    "GOPATH": "$PWD/.devbox/go",
    "GOBIN":  "$PWD/.devbox/go/bin",
    "PATH":   "$GOBIN:$HOME/.cargo/bin:$HOME/.local/bin:$PATH",
    "GOFLAGS": "-p=4",
    "JVM_ARGS": "-Xmx3g",
    "JAVA_TOOL_OPTIONS": "-Xmx3g",
    "SHARDS": "4"
  },
  "shell": {
    "init_hook": [
      "go version"
    ],
    "scripts": {
      "build":         [
        "go build ./...",
        "go -C cmd/cask-apiserver build ./..."
      ],
      "test":          [
        "go test -race ./...",
        "go -C cmd/cask-apiserver test -race ./..."
      ],
      "tidy":          [
        "go mod tidy",
        "go -C cmd/cask-apiserver mod tidy"
      ],
      "sim-gate":      ["scripts/sim-gate.sh"],
      "quint":         ["scripts/quint-check.sh"],
      "quint-verify":  ["scripts/quint-check.sh --verify"],
      "duvet-install": ["command -v duvet >/dev/null || cargo install duvet --locked"],
      "spec":          [
        "duvet extract -f markdown docs/spec/fleet.md -o docs/spec",
        "duvet report --html .duvet/report.html"
      ],
      "duvet-ci":      ["duvet report --ci"],
      "e2e":           ["scripts/e2e.sh"],
      "issues":        ["scripts/file-issues.sh docs/issues/fleet.md"],
      "verify":        [
        "go test -race ./...",
        "go -C cmd/cask-apiserver test -race ./...",
        "scripts/quint-check.sh",
        "duvet report --ci"
      ]
    }
  }
}
